<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30A76505">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#FFF1D6" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/temple_gold_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFDF5" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1.8dp"
                        android:color="@color/temple_gold_primary" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
