<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20A76505">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#FFF8EC" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/temple_gold_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#E0D6C3" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
