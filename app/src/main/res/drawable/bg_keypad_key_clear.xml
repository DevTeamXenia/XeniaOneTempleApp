<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33E53935">

    <item>
        <selector>
            <item android:state_pressed="true">
                <layer-list>
                    <item android:top="2dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#E8B4B0" />
                            <corners android:radius="100dp" />
                        </shape>
                    </item>
                    <item android:top="1dp" android:bottom="1dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="90"
                                android:startColor="#FFE3E0"
                                android:endColor="#FFF1EF" />
                            <corners android:radius="100dp" />
                            <stroke android:width="1.5dp" android:color="#E57373" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <item>
                <layer-list>
                    <item android:top="2dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#F0C4C0" />
                            <corners android:radius="100dp" />
                        </shape>
                    </item>
                    <item android:bottom="2dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="90"
                                android:startColor="#FFEDEA"
                                android:endColor="#FFFFFF" />
                            <corners android:radius="100dp" />
                            <stroke android:width="1.5dp" android:color="#E57373" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</ripple>
