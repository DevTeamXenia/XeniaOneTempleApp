<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/temple_card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="Sales &amp; Items Report"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Date/Time Range Filter Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportFromDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="From Date &amp; Time"
                android:focusable="false"
                android:clickable="true"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportToDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="To Date &amp; Time"
                android:focusable="false"
                android:clickable="true"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Table Header (Item - Qty - Amount) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/temple_gold_light"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:fontFamily="sans-serif-bold"
            android:text="Item Name"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Qty"
            android:gravity="center"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Amount"
            android:gravity="end"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Scrollable Items List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginVertical="8dp">

        <LinearLayout
            android:id="@+id/layoutReportItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamically added rows -->
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/table_divider"
        android:layout_marginVertical="8dp" />

    <!-- Total Amount Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Total Amount:"
            android:textColor="@color/text_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvReportTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="₹0.00"
            android:textColor="@color/temple_gold_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Bottom Buttons: Cancel (Left) and Print (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReport"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Cancel"
            android:textColor="@color/text_dark"
            app:strokeColor="@color/table_divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrintReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Print"
            android:textColor="@color/white"
            app:backgroundTint="@color/temple_gold_primary" />
    </LinearLayout>

</LinearLayout>
