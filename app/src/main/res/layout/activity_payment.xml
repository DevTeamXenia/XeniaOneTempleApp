<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F2EE">

    <!-- Transaction Successful content (centered between top and the bottom bar) -->
    <LinearLayout
        android:id="@+id/ll_success_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/receipt_scroll_padding_horizontal"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/receipt_content_max_width">

        <!-- Success check icon -->
        <ImageView
            android:id="@+id/iv_success_icon"
            android:layout_width="@dimen/receipt_success_icon_size"
            android:layout_height="@dimen/receipt_success_icon_size"
            android:contentDescription="Transaction successful"
            android:src="@drawable/ic_transaction_success" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/receipt_spacing_medium"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="Transaction Successful"
            android:textColor="#2E7D32"
            android:textSize="@dimen/receipt_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_success_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/receipt_spacing_small"
            android:gravity="center"
            android:text="Please check your WhatsApp for receipt "
            android:textColor="#555555"
            android:textSize="@dimen/receipt_meta_text_size" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/receipt_spacing_small"
            android:gravity="center"
            android:text="സ്വാമിയേ ശരണമയ്യപ്പാ"
            android:textColor="#555555"
            android:textSize="15sp" />

        <!-- Amount -->
        <TextView
            android:id="@+id/tv_receipt_total_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/receipt_spacing_large"
            android:fontFamily="sans-serif-medium"
            android:text="Total Amount : ₹520.00"
            android:textColor="#000000"
            android:textSize="@dimen/receipt_total_text_size"
            android:textStyle="bold" />

        <!-- Transaction details -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/receipt_spacing_large"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/receipt_card_elevation"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/receipt_content_padding_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/receipt_meta_label_width"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Receipt No :"
                        android:textColor="#222222"
                        android:textSize="@dimen/receipt_meta_text_size" />

                    <TextView
                        android:id="@+id/tv_receipt_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="27533365"
                        android:textColor="#000000"
                        android:textSize="@dimen/receipt_meta_text_size" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/receipt_spacing_small"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/receipt_meta_label_width"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Date :"
                        android:textColor="#222222"
                        android:textSize="@dimen/receipt_meta_text_size" />

                    <TextView
                        android:id="@+id/tv_receipt_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04 - Sep - 2024  07: 50 AM"
                        android:textColor="#222222"
                        android:textSize="@dimen/receipt_meta_text_size" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_receipt_upi_ref"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/receipt_spacing_small"
                    android:text="UPI Reference No: 5647784112"
                    android:textColor="#444444"
                    android:textSize="@dimen/receipt_meta_text_size" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Printing Status Indicator -->
        <LinearLayout
            android:id="@+id/ll_printing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/receipt_status_margin_top"
            android:gravity="center"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/pb_printer"
                android:layout_width="@dimen/receipt_status_progress_size"
                android:layout_height="@dimen/receipt_status_progress_size"
                android:indeterminateTint="#FFA000" />

            <TextView
                android:id="@+id/tv_printer_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginStart="@dimen/receipt_status_text_margin_start"
                android:fontFamily="sans-serif-medium"
                android:text="Connecting to Kiosk thermal printer..."
                android:textColor="#424242"
                android:textSize="@dimen/receipt_meta_text_size" />
        </LinearLayout>

        <!-- Kept hidden so PaymentActivity's existing bindings still work.
             The printed receipt is drawn from a bitmap, not from these views. -->
        <LinearLayout
            android:id="@+id/ll_hidden_receipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ll_receipt_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <ImageView
                android:id="@+id/iv_receipt_qr"
                android:layout_width="@dimen/receipt_qr_size"
                android:layout_height="@dimen/receipt_qr_size"
                android:contentDescription="Receipt QR"
                tools:srcCompat="@tools:sample/avatars" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Actions Bar: Print Receipt & New Order -->
    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/receipt_bottom_bar_margin_horizontal"
        android:layout_marginBottom="@dimen/receipt_bottom_bar_margin_bottom"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/receipt_content_max_width">

        <!-- Print Receipt Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_print_receipt"
            android:layout_width="0dp"
            android:layout_height="@dimen/receipt_button_height"
            android:layout_marginEnd="@dimen/receipt_button_gap_half"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="Print Receipt"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/receipt_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="#FFA000"
            app:cornerRadius="@dimen/receipt_button_corner_radius"
            app:icon="@drawable/ic_print"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/receipt_button_icon_padding"
            app:iconTint="#FFFFFF" />

        <!-- New Order / Done Button with Countdown -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_order"
            android:layout_width="0dp"
            android:layout_height="@dimen/receipt_button_height"
            android:layout_marginStart="@dimen/receipt_button_gap_half"
            android:layout_weight="1"
            android:text="Done (15s)"
            android:visibility="gone"
            android:textColor="#333333"
            android:textSize="@dimen/receipt_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="@dimen/receipt_button_corner_radius"
            app:strokeColor="#CCCCCC"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>