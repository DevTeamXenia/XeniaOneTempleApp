<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/order_row_height"
    android:background="@drawable/bg_row_border"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/order_row_padding_horizontal">

    <TextView
        android:id="@+id/tvRowIndex"
        android:layout_width="@dimen/order_row_index_width"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="01"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/order_row_text_size" />

    <TextView
        android:id="@+id/tvRowItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/order_row_item_name_margin_start"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Appam"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/order_row_text_size" />

    <TextView
        android:id="@+id/tvRowQty"
        android:layout_width="@dimen/order_row_qty_width"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/order_row_text_size" />

    <TextView
        android:id="@+id/tvRowPrice"
        android:layout_width="@dimen/order_row_price_width"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:gravity="end"
        android:text="40.00"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/order_row_text_size" />

    <TextView
        android:id="@+id/tvRowTotal"
        android:layout_width="@dimen/order_row_total_width"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:text="120.00"
        android:textColor="@color/text_dark"
        android:textSize="@dimen/order_row_text_size" />

    <!-- Remove Item Button (Orange/Red X) -->
    <ImageButton
        android:id="@+id/btnRemoveRow"
        android:layout_width="@dimen/order_row_remove_size"
        android:layout_height="@dimen/order_row_remove_size"
        android:layout_marginStart="@dimen/order_row_remove_margin_start"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove Item"
        android:padding="@dimen/order_row_remove_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:tint="@color/pay_button_orange" />

</LinearLayout>