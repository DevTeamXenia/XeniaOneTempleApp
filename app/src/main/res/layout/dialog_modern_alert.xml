<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_modern_dialog"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="22dp">

    <!-- Icon Circle -->
    <FrameLayout
        android:id="@+id/flAlertIconContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_language_card_selected">

        <ImageView
            android:id="@+id/ivAlertIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Alert Icon"
            android:src="@drawable/ic_pinelabs_pos" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:text="Transaction Status"
        android:textColor="@color/text_dark"
        android:textSize="18sp" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvAlertMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Payment details and messages appear here."
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <!-- Action Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAlertAction"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_pay_button"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.05"
        android:text="OK"
        android:textColor="@color/white"
        android:textSize="15sp" />

</LinearLayout>
