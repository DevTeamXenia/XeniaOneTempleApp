<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_modern_dialog"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="22dp">

    <!-- Icon Container -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_language_card_selected">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Cash Icon"
            android:src="@drawable/ic_credit_card" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:text="Enter Payment Reference ID"
        android:textColor="@color/text_dark"
        android:textSize="18sp" />

    <!-- Subtitle / Instruction -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="Please enter the reference ID for this cash transaction"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <!-- EditText for Reference ID -->
    <EditText
        android:id="@+id/etCashRefId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_row_border"
        android:fontFamily="sans-serif-medium"
        android:hint="Enter Reference ID"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_dark"
        android:textSize="15sp" />

    <!-- Continue Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCashContinue"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_pay_button"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.05"
        android:text="CONTINUE"
        android:textColor="@color/white"
        android:textSize="15sp" />

</LinearLayout>
